{
  "$comment": "TEMPORARY spike probe wiring. Removed once docs/design/platform-facts.md is written. Lives in settings.json (not settings.local.json) because the permission system rewrites the latter.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${CLAUDE_PROJECT_DIR}/test/probe/probe.mjs\" session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${CLAUDE_PROJECT_DIR}/test/probe/probe.mjs\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${CLAUDE_PROJECT_DIR}/test/probe/probe.mjs\" pre-write"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"${CLAUDE_PROJECT_DIR}/test/probe/probe.mjs\" pre-bash"
          }
        ]
      }
    ]
  }
}
