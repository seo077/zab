{
  "name": "interlocking",
  "version": "0.1.0",
  "private": true,
  "description": "Repo tooling for the `il` Claude Code plugin. The plugin itself ships no dependencies and does not require npm to run.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "validate": "claude plugin validate . --strict",
    "check": "npm run validate && npm test",
    "test:node18": "npx -y node@18.20.8 test/run.mjs",
    "test:node20": "npx -y node@20.19.0 test/run.mjs"
  }
}
